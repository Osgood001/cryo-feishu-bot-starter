# lark-cli profile that has the Feishu app/user/bot auth.
LARK_CLI_PROFILE=your_lark_cli_profile

# Identity used by proactive-post.sh. Usually "bot".
LARK_CLI_IDENTITY=bot

# Optional signature appended to proactive messages.
BOT_SIGNATURE="sent by your agent"

# Local connector outbox watched by your Feishu bridge.
FEISHU_OUTBOX_DIR=messages/outbox

# Operator user open_id for status-only notes.
OPERATOR_OPEN_ID=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional default chat used by local testing scripts.
DEFAULT_FEISHU_CHAT_ID=oc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
