# Copy to .env, replace every REPLACE_WITH_* value, then: chmod 600 .env
# This file contains paths and identifiers, never app credentials or access tokens.
CHAMBER_DIR=REPLACE_WITH_ABSOLUTE_CHAMBER_PATH
CONNECTOR_STATE_DIR=REPLACE_WITH_ABSOLUTE_STATE_PATH
LARK_CLI=REPLACE_WITH_ABSOLUTE_LARK_CLI_PATH
LARK_CLI_PROFILE=REPLACE_WITH_LARK_PROFILE_NAME
CRYO_AGENT=REPLACE_WITH_ABSOLUTE_CRYO_AGENT_PATH

# Inbound bot matching and outbound presentation.
FEISHU_BOT_NAME=REPLACE_WITH_BOT_DISPLAY_NAME
FEISHU_BOT_OPEN_ID=ou_REPLACE_WITH_BOT_OPEN_ID
BOT_SIGNATURE=REPLACE_WITH_PUBLIC_BOT_SIGNATURE

# Connector limits (safe defaults).
OUTBOX_POLL_SEC=2
DEADLETTER_AFTER_SEC=900
MAX_REPLY_CHARS=20000

# Wrapper and inspection-script settings.
FEISHU_OUTBOX_DIR=REPLACE_WITH_ABSOLUTE_OUTBOX_PATH
LARK_CLI_IDENTITY=bot
OPERATOR_OPEN_ID=ou_REPLACE_WITH_OPERATOR_OPEN_ID
DEFAULT_FEISHU_CHAT_ID=oc_REPLACE_WITH_TEST_CHAT_ID
FEISHU_SCAN_AS_PRIMARY=user
FEISHU_SCAN_AS_FALLBACK=bot
